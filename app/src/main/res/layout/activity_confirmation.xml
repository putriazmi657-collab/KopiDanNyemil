<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF8F0"
    android:fillViewport="true">


<LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🧾"
                    android:textSize="48sp"
                    android:layout_gravity="center"
                    android:layout_marginTop="12dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Konfirmasi Pesanan"
                    android:textSize="25sp"
                    android:textStyle="bold"
                    android:textColor="#5D4037"
                    android:gravity="center"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Periksa kembali pesanan dan alamat pengirimanmu."
                    android:textSize="14sp"
                    android:textColor="#8D6E63"
                    android:gravity="center"
                    android:layout_marginBottom="24dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp"
                    android:background="#F5E8DA"
                    android:layout_marginBottom="16dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Detail Pesanan"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="#5D4037"
                            android:layout_marginBottom="14dp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Menu"
                            android:textStyle="bold"
                            android:textColor="#8D6E63"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/tvConfirmProduct"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="-"
                            android:textSize="16sp"
                            android:textColor="#3E2723"
                            android:layout_marginBottom="12dp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Harga"
                            android:textStyle="bold"
                            android:textColor="#8D6E63"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/tvConfirmPrice"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="-"
                            android:textSize="16sp"
                            android:textColor="#3E2723" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="#D7BFAE"
                            android:layout_marginTop="14dp"
                            android:layout_marginBottom="14dp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Total Pembayaran"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:textColor="#5D4037" />

                        <TextView
                            android:id="@+id/tvConfirmTotal"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="-"
                            android:textSize="22sp"
                            android:textStyle="bold"
                            android:textColor="#795548"
                            android:layout_marginTop="5dp" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp"
                    android:background="#F5E8DA"
                    android:layout_marginBottom="22dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="📍 Alamat Pengiriman"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="#5D4037"
                            android:layout_marginBottom="14dp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Nama Penerima"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="#8D6E63" />

                        <TextView
                            android:id="@+id/tvConfirmRecipient"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="-"
                            android:textSize="15sp"
                            android:textColor="#3E2723"
                            android:layout_marginBottom="12dp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Nomor Telepon"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="#8D6E63" />

                        <TextView
                            android:id="@+id/tvConfirmPhone"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="-"
                            android:textSize="15sp"
                            android:textColor="#3E2723"
                            android:layout_marginBottom="12dp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Alamat Lengkap"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="#8D6E63" />

                        <TextView
                            android:id="@+id/tvConfirmAddress"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="-"
                            android:textSize="15sp"
                            android:textColor="#3E2723" />

                </LinearLayout>

                <Button
                    android:id="@+id/btnFinishOrder"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:text="Konfirmasi Pesanan"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#795548"
                    android:layout_marginBottom="12dp" />

                <Button
                    android:id="@+id/btnConfirmationBack"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="Kembali"
                    android:textSize="15sp"
                    android:textColor="#5D4037"
                    android:backgroundTint="#E8D5C4" />

        </LinearLayout>

</ScrollView>
