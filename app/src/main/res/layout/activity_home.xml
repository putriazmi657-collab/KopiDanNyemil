<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF8F0"
    android:fillViewport="true">


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="☕ KOPI DAN NYEMIL"
            android:textColor="#5D4037"
            android:textSize="25sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvWelcome"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Halo, Pengguna!"
            android:textColor="#795548"
            android:textSize="16sp"
            android:layout_marginTop="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#EAD5C0"
            android:padding="20dp"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="24dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Nikmati Hari dengan Secangkir Kopi"
                android:textColor="#4E342E"
                android:textSize="21sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Temukan kopi favorit dan camilan lezat untuk menemani harimu."
                android:textColor="#6D4C41"
                android:textSize="14sp"
                android:layout_marginTop="10dp" />

        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Menu Favorit Kami"
            android:textColor="#5D4037"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <!-- Menu 1 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="16dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="☕  Kopi Susu Gula Aren"
                android:textColor="#5D4037"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Kopi creamy dengan manis gula aren."
                android:textColor="#795548"
                android:textSize="14sp"
                android:layout_marginTop="6dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Rp22.000"
                android:textColor="#8D6E63"
                android:textStyle="bold"
                android:layout_marginTop="8dp" />

            <Button
                android:id="@+id/btnProduct1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Pilih Menu"
                android:backgroundTint="#8D6E63"
                android:textColor="#FFFFFF" />

        </LinearLayout>

        <!-- Menu 2 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="16dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🍩  Donat Cokelat"
                android:textColor="#5D4037"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Donat lembut dengan lapisan cokelat."
                android:textColor="#795548"
                android:textSize="14sp"
                android:layout_marginTop="6dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Rp12.000"
                android:textColor="#8D6E63"
                android:textStyle="bold"
                android:layout_marginTop="8dp" />

            <Button
                android:id="@+id/btnProduct2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Pilih Menu"
                android:backgroundTint="#8D6E63"
                android:textColor="#FFFFFF" />

        </LinearLayout>

        <!-- Menu 3 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="16dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🍞  Sourdough Loaf"
                android:textColor="#5D4037"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Roti sourdough dengan tekstur lembut."
                android:textColor="#795548"
                android:textSize="14sp"
                android:layout_marginTop="6dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Rp35.000"
                android:textColor="#8D6E63"
                android:textStyle="bold"
                android:layout_marginTop="8dp" />

            <Button
                android:id="@+id/btnProduct3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Pilih Menu"
                android:backgroundTint="#8D6E63"
                android:textColor="#FFFFFF" />

        </LinearLayout>

        <!-- Menu 4 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="16dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="☕  Cappuccino"
                android:textColor="#5D4037"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Perpaduan espresso dan susu berbusa."
                android:textColor="#795548"
                android:textSize="14sp"
                android:layout_marginTop="6dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Rp25.000"
                android:textColor="#8D6E63"
                android:textStyle="bold"
                android:layout_marginTop="8dp" />

            <Button
                android:id="@+id/btnProduct4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Pilih Menu"
                android:backgroundTint="#8D6E63"
                android:textColor="#FFFFFF" />

        </LinearLayout>

        <!-- Menu 5 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🍵  Matcha Latte"
                android:textColor="#5D4037"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Minuman matcha dengan campuran susu."
                android:textColor="#795548"
                android:textSize="14sp"
                android:layout_marginTop="6dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Rp27.000"
                android:textColor="#8D6E63"
                android:textStyle="bold"
                android:layout_marginTop="8dp" />

            <Button
                android:id="@+id/btnProduct5"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Pilih Menu"
                android:backgroundTint="#8D6E63"
                android:textColor="#FFFFFF" />

        </LinearLayout>

        <TextView
            android:id="@+id/tvSelectedProduct"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Belum ada menu yang dipilih"
            android:textColor="#5D4037"
            android:textSize="15sp"
            android:textStyle="bold"
            android:padding="12dp"
            android:background="#EAD5C0"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btnOrder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Pesan Sekarang"
            android:backgroundTint="#5D4037"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/btnProfile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Profile Saya"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="20dp"
            android:backgroundTint="#A1887F"
            android:textColor="#FFFFFF" />

    </LinearLayout>
</ScrollView>
